# -------------------------------------------------------------------
# Local LLM Google Workspace Integrator - 환경 설정 템플릿
# 이 파일을 복사하여 .env 파일을 생성하고 실제 설정을 채워 넣으세요.
# -------------------------------------------------------------------

# 1. LLM 추론 서버 설정
# LLM_SERVE_MODE: 
#   - "llamacpp" (내장 llama.cpp 서버 구동 및 자동 연결)
#   - "ollama"   (로컬 Ollama 연결)
#   - "external" (기타 외부 OpenAI 호환 API 서버 연결)
LLM_SERVE_MODE=llamacpp

# 로컬 LLM 서버 기동 시 사용할 모델 파일명 또는 API 모델명
LLM_MODEL=

# 내장 llama.cpp 호스트 및 포트 설정 (LLM_SERVE_MODE=llamacpp 일 때 활성)
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8080

# 로컬 Ollama API 주소 (LLM_SERVE_MODE=ollama 일 때 활성)
OLLAMA_BASE=http://localhost:11434/v1

# 수동 입력 외부 API 설정 (LLM_SERVE_MODE=external 일 때 활성)
LLM_API_BASE=http://127.0.0.1:8080/v1
LLM_API_KEY=not-needed

# 2. 하네스 RAG 자율 에이전트 설정
HARNESS_MAX_TURNS=15
HARNESS_TOP_K=5
HARNESS_BM25_TOP_N=4

# 3. Notion OAuth 연동 설정 (공용 통합)
# Notion 개발자 사이트(https://developers.notion.com)에서 발급받은 값을 입력하세요.
# 리디렉션 URL은 아래 주소를 노션 통합 페이지에 등록해야 작동합니다:
# http://localhost:18731/api/auth/notion/callback
# 외부 베타 전에는 실제 secret 공유 이력을 확인하고 ROTATED 또는 N/A로 기록하세요.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:18731/api/auth/notion/callback
