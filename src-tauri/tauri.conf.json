{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local LLM GWS",
  "version": "0.1.0",
  "identifier": "com.fkjy1.localllmgws",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:18732",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local LLM GWS",
        "width": 1280,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 760,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:18731 http://127.0.0.1:18731 http://localhost:18732 http://127.0.0.1:18732; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "bin/gws-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
